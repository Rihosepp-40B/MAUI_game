<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"             
             xmlns:vm="clr-namespace:MAUI_game.ViewModels"
             x:Class="MAUI_game.Views.SettingsView">

    <ContentView.BindingContext>
        <vm:GameLanguageViewModel />
    </ContentView.BindingContext>
    
    <VerticalStackLayout>

        <Label Text="{Binding Settings}" TextColor="White" FontSize="22" HorizontalOptions="Center" FontAttributes="Bold"/>
        
        <!--Keele valiku label ja picker-->
        <Label Text="{Binding ChooseLanguage}" TextColor="White" FontSize="16"/>
        <Picker x:Name="LanguagePicker"
                Title="{Binding ChooseHere}"
                ItemsSource="{Binding Languages}"
                SelectedItem="{Binding SelectedLanguage}"
                TextColor="White"
                TitleColor="LightGray"
                BackgroundColor="#333333" />
        
        <!--Teema valiku label ja picker-->
        <Label Text="{Binding ChooseTheme}" TextColor="White" FontSize="16"/>
        <Picker x:Name="ThemePicker"
                Title="{Binding ChooseHere}"
                ItemsSource="{Binding ThemeList}"
                TextColor="White"
                TitleColor="LightGray"
                BackgroundColor="#333333" 
                SelectedIndexChanged="OnThemePickerChanged"/>
        
        <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
            <Label Text="{Binding Audio}" VerticalTextAlignment="Center" FontSize="16" />
            <Switch x:Name="SoundSwitch" Toggled="OnSoundSwitchToggled" />
        </HorizontalStackLayout>


        <!-- Tagasi nupp -->
        <Button Text="{Binding Back}" BackgroundColor="#CC0000" TextColor="White" Clicked="OnCloseClicked" WidthRequest="200"/>
    </VerticalStackLayout>
</ContentView>
